# Plantilla de Configuración de Entorno — SIGCGOE (Universidad de Holguín)
SECRET_KEY=django-insecure-uho-system-development-key-2026-v1
DEBUG=False
ALLOWED_HOSTS=guardia.uho.edu.cu,localhost,127.0.0.1,[::1]

# Base de Datos Relacional de Producción (PostgreSQL 15+ — RNF-16)
DATABASE_URL=postgres://sigcgoe_user:sigcgoe_prod_pass@bd.uho.edu.cu:5432/sigcgoe_uho_db

# Servicios Institucionales Centrales de la Universidad de Holguín (RNF-15)
AGA_AUTH_URL=https://auth.uho.edu.cu/api/v1
ASSET_API_URL=https://asset.uho.edu.cu/api/v1
SIGENU_API_URL=https://sigenu.uho.edu.cu/api/v1

# Almacenamiento de archivos S3 / MinIO
USE_MINIO=False
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=uho-media
MINIO_ENDPOINT=http://localhost:9000

# Parámetros del Token JWT (RNF-06)
JWT_ACCESS_LIFETIME_MINS=120
JWT_REFRESH_LIFETIME_DAYS=7

# Configuración de CORS
CORS_ALLOW_ALL_ORIGINS=True
